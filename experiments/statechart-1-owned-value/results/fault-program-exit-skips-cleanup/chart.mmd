---
title: "The life of one owned value in one routine"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: running
    lg1: exit cleanup
    lg2: left
    lg3: ended by panic, no cleanup
    lg4: Breaks ProgramExitDisposesEachStartupValueOnce in some cases
    lg5: Path to the ProgramExitDisposesEachStartupValueOnce bug
  }
  class lg0 blue
  class lg1 orange
  class lg2 teal
  class lg3 pink
  class lg4 mayBreak
  class lg5 bugPath
  state "At the same time" as all {
    state "Owned value" as r0 {
      s0: Uninitialized
      s1: Initialized
      s2: Remaining-field cleanup
      s3: Moved out
      s4: Disposed
      [*] --> s0
      s0 --> s1: the value is initialized [when Running]
      s1 --> s2: the routine calls dispose on the value [when Running]
      s1 --> s3: the whole value is moved out [when Running]
      s2 --> s4: the last remaining field is cleaned up [when Running]
    }
    --
    state "Routine" as r1 {
      s5: Running
      s6: Startup complete: cleaning up the startup scope
      s7: Program ended by panic
      s8: Program exited
      [*] --> s5
      s5 --> s6: startup completes [unless Remaining-field cleanup]
      s5 --> s7: a panic begins
      s6 --> s8: cleanup is complete, the program exits
      s6 --> s7: a panic begins
    }
  }
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 bugPath
  class s1 mayBreak
  class s1 bugPath
  class s5 blue
  class s5 bugPath
  class s6 orange
  class s6 bugPath
  class s7 pink
  class s8 teal
  class s8 mayBreak
  class s8 bugPath
