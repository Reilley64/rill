---
title: "The life of one owned value in one routine"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: running
    lg1: exit cleanup
    lg2: left
    lg3: ended by panic, no cleanup
    lg4: Breaks MovedValueNeverDisposed or NormalExitDisposesEachOwnedValueOnce or PropagationExitDisposesEachOwnedValueOnce or ValueDisposedAtMostOnce in some cases
    lg5: Path to the MovedValueNeverDisposed or NormalExitDisposesEachOwnedValueOnce or PropagationExitDisposesEachOwnedValueOnce or ValueDisposedAtMostOnce bug
  }
  class lg0 blue
  class lg1 orange
  class lg2 teal
  class lg3 pink
  class lg4 mayBreak
  class lg5 bugPath
  state "At the same time" as all {
    state "Owned value" as r0 {
      s0: Uninitialized
      s1: Initialized
      s2: Remaining-field cleanup
      s3: Moved out
      s4: Disposed
      [*] --> s0
      s0 --> s1: the value is initialized [when Running]
      s1 --> s2: the routine calls dispose on the value [when Running]
      s1 --> s3: the whole value is moved out [when Running]
      s1 --> s2: exit cleanup begins on the value [when Normal exit: cleaning up or Propagation exit: cleaning up]
      s2 --> s4: the last remaining field is cleaned up [unless Program ended by panic]
    }
    --
    state "Routine" as r1 {
      s5: Running
      s6: Normal exit: cleaning up
      s7: Propagation exit: failure not yet in the caller's result
      s8: Program ended by panic
      s9: Left by normal exit
      s10: Propagation exit: cleaning up
      s11: Left by propagation exit
      [*] --> s5
      s5 --> s6: the routine returns [unless Remaining-field cleanup]
      s5 --> s7: the routine propagates a failure [unless Remaining-field cleanup]
      s5 --> s8: a panic begins
      s6 --> s9: cleanup is complete, the routine returns to its caller [unless Initialized or Remaining-field cleanup]
      s6 --> s8: a panic begins
      s7 --> s10: the failure moves into the caller's result
      s7 --> s8: a panic begins
      s10 --> s11: cleanup is complete, the caller receives the failure [unless Initialized or Remaining-field cleanup]
      s10 --> s8: a panic begins
    }
  }
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 bugPath
  class s1 bugPath
  class s2 bugPath
  class s3 mayBreak
  class s3 bugPath
  class s4 mayBreak
  class s4 bugPath
  class s5 blue
  class s5 bugPath
  class s6 orange
  class s6 mayBreak
  class s6 bugPath
  class s7 orange
  class s7 bugPath
  class s8 pink
  class s8 mayBreak
  class s9 teal
  class s9 mayBreak
  class s9 bugPath
  class s10 orange
  class s10 mayBreak
  class s10 bugPath
  class s11 teal
  class s11 mayBreak
  class s11 bugPath
