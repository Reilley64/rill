import std::bytes::{Bytes};
import std::collection::{List};
import std::result::{Result};

export type Inputs = { private arguments: List<Bytes>; };

enum EnvErrorKind { AcquisitionFailed, InvalidArgument, InvalidUtf8 }
export type EnvError = { private kind: EnvErrorKind; };

export function inputs(): Result<Inputs, EnvError> {
    return captureInputs();
}

export function args(inputs: &Inputs): Result<List<string>, EnvError> {
    return decodeArguments(inputs);
}

function captureInputs(): Result<Inputs, EnvError>;
function decodeArguments(inputs: &Inputs): Result<List<string>, EnvError>;
