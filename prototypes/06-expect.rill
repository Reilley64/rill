// Expectations live next to the code they test. No imports are needed.

function add(a: i32, b: i32): i32 {
  return a + b;
}

expect add(2, 3) == 5;
expect add(-1, 1) == 0;
expect add(0, 0) == 0;

// rill test runs these expectations, even when this module is imported.
// Ordinary builds do not run them or include their test-only code.

