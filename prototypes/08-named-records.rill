// Named record construction for #21. No anonymous structural records.
// These are design examples, not executed compiler tests yet.

type Point = { x: i32; y: i32 };
type ScreenPoint = { x: i32; y: i32 };
type Box<T> = { value: T };

function origin(): Point {
  return Point { x: 0, y: 0 };
}

function xOf(point: &Point): i32 {
  return point.x;
}

function inferredX(): i32 {
  // Infer from an already typed expression, not from later uses.
  let point = origin();
  return point.x;
}

function annotatedX(): i32 {
  // The annotation checks the constructor's type; it does not create identity.
  let point: Point = Point { x: 4, y: 5 };
  return point.x;
}

function rebuiltX(): i32 {
  let point = Point { x: 1, y: 2 };
  let rebuilt = Point { ...point, x: 3 };
  return rebuilt.x;
}

function boxedValue(): i32 {
  let box = Box<i32> { value: 7 };
  return box.value;
}

expect xOf(&Point { x: 2, y: 3 }) == 2;
expect inferredX() == 0;
expect annotatedX() == 4;
expect rebuiltX() == 3;
expect boxedValue() == 7;

