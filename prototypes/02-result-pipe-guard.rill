import std::log;
import std::result::{Result, Ok, Err, andThen, map};
// Typed parser spelling/error interface is illustrative pending #23.
import std::string::parse;
// Canonical error display's module path remains provisional for #23.
import std::error::display;

type PortError = { detail: string };

function display(error: &PortError): string {
  return `${error.detail}`;
}

function parsePort(text: string): Result<i32, PortError> {
  let port = parse<i32>(&text) ? PortError { detail: `not a port: ${text}` };
  guard port > 0 && port < 65536 else {
    return Err(PortError { detail: `out of range: ${port}` });
  }
  return Ok(port);
}

function rejectReserved(port: i32): Result<i32, PortError> {
  guard port >= 1024 else {
    return Err(PortError { detail: `reserved port: ${port}` });
  }
  return Ok(port);
}

function toAddress(port: i32): string {
  return `localhost:${port}`;
}

function start(text: string): string {
  let address = text
    |> parsePort
    |> andThen(rejectReserved)
    |> map(toAddress);

  guard let listening = address else (error) {
    return `error: ${error}`;
  }
  return `listening on ${listening}`;
}

log(start("8080"));
log(start("80x0"));

// Output (runtime formatting is illustrative for #23):
// listening on localhost:8080
// error: not a port: 80x0
//   at parsePort (the infix ? construction location in this file)
// caused by: invalid digit "x" at index 2
//   at parse (its construction location in std/string.rill)
// Only construction locations appear: start/andThen/map add no propagation entries.
// The RHS is an error value, not a handler; it is skipped when parsing succeeds.
// ADR 0013 defines caused-by semantics; #28 still owes complete operator grammar.

// Test-only expectations; no dependence on the top-level log calls.
expect start("8080") == "listening on localhost:8080";
expect start("1024") == "listening on localhost:1024";
expect start("65535") == "listening on localhost:65535";
