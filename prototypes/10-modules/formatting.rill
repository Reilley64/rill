// The exported declaration owns this family's identity and visibility.
export function show<T>(value: &T): string;

function show(value: &int): string {
  return `${value}`;
}

// Public requirements name an exported family, not a hidden private one.
export function render<T>(value: &T): string where show(T) {
  return show(value);
}

expect render(42) == "42";
