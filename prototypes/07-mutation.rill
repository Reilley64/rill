import std::log;
import std::collection::List;

// Design prototype for #15, not an executable compiler test yet.

type Point = { x: i32; y: i32 };

function increment(value: &mut i32): void {
  *value += 1;
}

function shiftRight(point: &mut Point): void {
  point.x += 1;
}

function shiftUp(point: &mut Point): void {
  point.y += 1;
}

function adjust(point: &mut Point): void {
  // Each call reborrows point; the first does not consume it.
  shiftRight(point);
  shiftUp(point);
}

function shifted(point: Point): Point {
  // Owned parameters are immutable bindings, so use a mutable local.
  let mut moved = point;
  adjust(&mut moved);
  return moved;
}

function total(numbers: &List<i32>): i32 {
  let mut result: i32 = 0;
  for (let n of numbers) {
    result += n;
  }
  return result;
}

function incremented(start: i32): i32 {
  let mut value = start;
  increment(&mut value);
  return value;
}

function independentCopies(): bool {
  let mut original = Point { x: 1, y: 2 };
  let mut changed = original; // Point still copies implicitly.
  changed.x = 9;
  return original.x == 1 && changed.x == 9;
}

function separateFields(): i32 {
  let mut point = Point { x: 1, y: 2 };
  let x = &mut point.x;
  let y = &mut point.y; // Disjoint named-field storage.
  *x += 1;
  *y += 2;
  // Both borrows have reached their last use.
  return point.x + point.y;
}

function invokeRead(work: &(() => i32)): i32 {
  return work();
}

function invokeMut(work: &mut (mut () => i32)): i32 {
  return work();
}

function invokeOnce(work: once () => string): string {
  return work();
}

function readExample(): i32 {
  let read: () => i32 = () => 42;
  return invokeRead(&read);
}

function counterExample(): i32 {
  let mut count: i32 = 0;
  // A stored closure captures by value: this owns its own copied counter.
  let mut next: mut () => i32 = () => {
    count += 1;
    return count;
  };
  let first = invokeMut(&mut next);
  let second = invokeMut(&mut next);
  return first * 10 + second;
}

function takeExample(text: string): string {
  // Returning the non-copying captured string makes this a consuming callable.
  let take: once () => string = () => text;
  return invokeOnce(take);
}

function identity<T>(value: T): T {
  return value;
}

function carriedBorrow(): i32 {
  let owner: i32 = 42;
  let view = identity(&owner);
  // Passing a reference through an owned generic parameter preserves its borrow.
  return *view;
}

function remember(slot: &mut &Point, point: &Point): void {
  *slot = point;
}

function retainedInput(): i32 {
  let first = Point { x: 1, y: 2 };
  let second = Point { x: 9, y: 10 };
  let mut selected = &first;
  remember(&mut selected, &second);
  // The access loan ends at the call, but selected retains source dependencies.
  return selected.x;
}

// Illustrates the intrinsic contract; ordinary identity needs no such constraint.
function requireNoBorrow<T>(value: T): T where noBorrow(T) {
  return value;
}

log(`sum ${total(&[1, 2, 3, 4])}`);
log(`counter ${counterExample()}`);

// Output:
// sum 10
// counter 12

// Independent, top-level expectations: none rely on the startup log calls.
expect total(&[1, 2, 3, 4]) == 10;
expect total(&[]) == 0;
expect incremented(4) == 5;
expect shifted(Point { x: 1, y: 2 }).x == 2;
expect shifted(Point { x: 1, y: 2 }).y == 3;
expect independentCopies();
expect separateFields() == 6;
expect readExample() == 42;
expect counterExample() == 12;
expect takeExample("hello") == "hello";
expect carriedBorrow() == 42;
expect retainedInput() == 9;
expect requireNoBorrow(42i32) == 42;
