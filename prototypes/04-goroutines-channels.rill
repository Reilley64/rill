import std::log;
import std::list::{List, sum, length};
import std::channel::{Channel, channel, send, receive, close};
import std::routine::{all, allSettled, race, any};
import std::result::{Result, Ok, Err};
import std::time::sleep;

// Background work: a queue of jobs shared by two workers.

function produce(jobs: Channel<int>, numbers: List<int>): void {
  for (let n of numbers) {
    send(jobs, n);
  }
  close(jobs);
}

function square(jobs: Channel<int>, results: Channel<string>, worker: int): void {
  for (let n of jobs) {
    sleep(10);
    send(results, `worker ${worker}: ${n} squared is ${n * n}`);
  }
}

let numbers = [1, 2, 3, 4];
let jobs = channel<int>();
let results = channel<string>();

go produce(jobs, numbers);
go square(jobs, results, 1);
go square(jobs, results, 2);

for (let _ of numbers) {
  log(receive(results));
}

// Waiting for results: run functions at the same time and wait.

function slowSum(numbers: List<int>): int {
  sleep(20);
  return numbers |> sum;
}

function slowLength(numbers: List<int>): int {
  sleep(10);
  return numbers |> length;
}

function quote(shop: "closed", delay: int): Result<int> {
  sleep(delay);
  return Err("shop is closed");
}

function quote(shop: string, delay: int): Result<int> {
  sleep(delay);
  return Ok(delay * 10);
}

function describe(result: Result<int>): string {
  guard let price = result else (error) {
    return `error: ${error}`;
  }
  return `price ${price}`;
}

function describe(result: Result<[int, int]>): string {
  guard let [first, second] = result else (error) {
    return `error: ${error}`;
  }
  return `prices ${first} and ${second}`;
}

let [total, count] = all(() => slowSum(numbers), () => slowLength(numbers));
log(`average ${total / count}`);

let quotes = all(() => quote("north", 30), () => quote("closed", 10));
log(`all: ${describe(quotes)}`);

let fastest = race(() => quote("north", 30), () => quote("south", 20));
log(`race: ${describe(fastest)}`);

let firstOk = any(() => quote("closed", 10), () => quote("south", 20));
log(`any: ${describe(firstOk)}`);

let [a, b] = allSettled(() => quote("closed", 10), () => quote("south", 20));
log(`allSettled: ${describe(a)}, ${describe(b)}`);

// Output (the first four lines come in any order):
// worker 1: 1 squared is 1
// worker 2: 2 squared is 4
// worker 1: 3 squared is 9
// worker 2: 4 squared is 16
// average 2
// all: error: shop is closed
// race: price 200
// any: price 200
// allSettled: error: shop is closed, price 200
