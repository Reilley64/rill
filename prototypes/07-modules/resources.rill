import std::log;
import formatting::show;

export type Ticket = { private code: i32; label: string };

export function issue(label: string): Ticket {
  return Ticket { code: 7, label: label };
}

export function ticketCode(ticket: &Ticket): i32 {
  return ticket.code;
}

export function rename(ticket: Ticket, label: string): Ticket {
  // Named rebuilding with a private field is permitted in its defining module.
  return Ticket { ...ticket, label: label };
}

type Hidden = { value: i32 };

export function hidden(value: i32): Hidden {
  return Hidden { value: value };
}

export function readHidden(value: &Hidden): i32 {
  return value.value;
}

// A private type can participate in a visible family without exposing its fields.
implement show(value: &Hidden): string {
  return `hidden ${value.value}`;
}

enum HiddenState { On, Off }

export function makeState(on: bool): HiddenState {
  return if (on) HiddenState.On else HiddenState.Off;
}

export function isOn(state: &HiddenState): bool {
  return match (state) {
    HiddenState.On => true,
    HiddenState.Off => false,
  };
}

// Ordinary demonstration code: ignored when imported or under rill test.
// resources.rill can also be the entry file, with this same directory as its root.
let demo = hidden(99);
log(show(&demo));

// Independent test input, never a capture of demo.
expect readHidden(&hidden(8)) == 8;
